PUBLIC_URL=http://127.0.0.1:8000
PORT=8000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# comma-separated numeric GitHub user ids (login は使わない)
ALLOWED_GITHUB_IDS=2429307

# カンマ区切りの name/version。空なら default/v1 + CLAUDE_MCP_COMMAND。
# 予定例（コマンドは pascal 側インストール後に埋める。パスはここで決めない）:
# MCP_SERVICES=codex-sub/v1,claude-sub/v1,adb/v1
# MCP_CODEX_SUB_V1_COMMAND=
# MCP_CLAUDE_SUB_V1_COMMAND=
# MCP_ADB_V1_COMMAND=

# MCP_SERVICES 未設定時のフォールバック（単一サービス default/v1）
CLAUDE_MCP_COMMAND=claude mcp serve
# CLAUDE_CWD=/home/legokichi
RUST_LOG=info,mcp_duxca_com=debug

# --- scripts/run.sh (CLI foreground only; Ctrl+C stops all) ---
# CLOUDFLARED_TOKEN_FILE=/home/box/.cloudflared/mcp-duxca-com.token
# CLOUDFLARED_TOKEN=   # or TUNNEL_TOKEN=  (prefer file; never commit)
# MCP_BIN=./target/debug/mcp-duxca-com
# MCP_USE_RELEASE=1
