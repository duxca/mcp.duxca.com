[Unit]
Description=mcp.duxca.com gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcp-duxca
Group=mcp-duxca
WorkingDirectory=/var/lib/mcp-duxca-com
Environment=HOME=/var/lib/mcp-duxca-com
Environment=PORT=8000
Environment=PUBLIC_URL=https://mcp.duxca.com
Environment=RUST_LOG=info,mcp_duxca_com=info
# GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET（CI が GitHub Secrets から書く）
# relay（/relay/v1）は常に有効で、認証は上の OAuth を使う（静的キーや webhook の env は無い）。
# 会話ログは journald に出る: journalctl -u mcp-duxca-com -f | grep 'relay:'
# 添付の全部屋の合計上限（既定 64 MB、1 部屋はその半分）を変えるときだけ RELAY_MAX_TOTAL_STORAGE_BYTES を runtime.env に置く。
EnvironmentFile=/etc/mcp-duxca-com/runtime.env
ExecStart=/opt/mcp-duxca-com/bin/mcp-duxca-com
Restart=on-failure
RestartSec=3
MemoryMax=350M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/mcp-duxca-com

[Install]
WantedBy=multi-user.target
