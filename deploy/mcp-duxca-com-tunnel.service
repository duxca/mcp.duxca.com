[Unit]
Description=Cloudflare Tunnel for mcp.duxca.com
After=network-online.target mcp-duxca-com.service
Wants=network-online.target

[Service]
Type=simple
User=mcp-duxca
Group=mcp-duxca
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate run --token-file /etc/mcp-duxca-com/tunnel.token
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
